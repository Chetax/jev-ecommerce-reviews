# ---- Amazon Bedrock (Claude) ----
# Bedrock API key (created in the Bedrock console). Or leave empty and use
# standard AWS credentials (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or AWS_PROFILE).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Model on Bedrock. Claude IDs (anthropic.*) use the Claude SDK; others use the Converse API.
# Amazon Nova works on any account with no Anthropic use-case form:
#   us.amazon.nova-2-lite-v1:0 (best Nova on our eval), us.amazon.nova-pro-v1:0, us.amazon.nova-lite-v1:0, us.amazon.nova-micro-v1:0
# Claude (needs the Anthropic use-case form in the Bedrock console): anthropic.claude-opus-5-5, anthropic.claude-haiku-5-5
# Nova prices are built in; BEDROCK_*_PRICE_PER_M apply to Claude.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Retried client-side if the primary model refuses a request. Empty disables.
BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-4-8
# low | medium | high  (low is plenty for classification)
BEDROCK_EFFORT=low
# USD per 1M tokens for cost benchmarks. Check https://aws.amazon.com/bedrock/pricing/
BEDROCK_INPUT_PRICE_PER_M=4.00
BEDROCK_OUTPUT_PRICE_PER_M=20.00

# ---- TypeSafe Jev (optional, paid; not available on Bedrock) ----
# Leave empty to run Bedrock-only. Set it to add Jev to classify/benchmark.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.13.0
JEV_INPUT_PRICE_PER_M=0.042

# ---- Google Sheets (optional) ----
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
SHEET_ID=
SHEET_INPUT_TAB=reviews
SHEET_OUTPUT_TAB=decisions

# Decisions whose lowest confidence is below this are flagged for human review
CONFIDENCE_THRESHOLD=0.8

# ---- Observability (optional) ----
# Trace every classification to Arize Phoenix (free, runs locally). Start it with:
#   uvx --python 3.12 --from arize-phoenix phoenix serve      (UI at http://localhost:6006)
# then set the endpoint below and install the extra: pip install -e '.[observe]'
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=jev-reviews
